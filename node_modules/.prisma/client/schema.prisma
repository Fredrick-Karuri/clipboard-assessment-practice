generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Shift {
  id         String   @id
  facilityId String
  workerId   String
  startTime  DateTime
  endTime    DateTime
  profession String
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
